#!name = WeiboIntl
#!desc = 微博轻享版/国际版去广告模块（基于真实抓包深度定制：传输层阻断 uve 开屏预载与 biz 商业策略，应用层精细清洗时间线与推荐）
#!author = iab0x00, kokoryh (Optimized by Antigravity)
#!url = https://raw.githubusercontent.com/hyq58/WeiboIntl/main/WeiboIntl.sgmodule
#!update = 2026-09-30

[Rule]
# 1. 传输层秒杀开屏预下载与实时开屏服务（实锤捕获 bootpreload 与 bootrealtime）
DOMAIN-SUFFIX,uve.weibo.com,REJECT

# 2. 传输层秒杀商业广告策略与赞助商系统（实锤捕获 adstrategy 与 vs.biz）
DOMAIN-SUFFIX,biz.weibo.com,REJECT

# 3. 拦截友盟数据统计与设备指纹上报
DOMAIN-SUFFIX,umeng.com,REJECT

[URL Rewrite]
# 1. 搜索框默认词/推广推荐词
^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?.*a=get_searching_info - reject-dict

# 2. 国际版通用广告配置接口
^https?:\/\/api\.weibo\.cn\/2\/ad\/ - reject-dict

[Body Rewrite]
# 1. 时间线去广告（全面覆盖热门流、关注流、分组流、话题流）
http-response-jq ^https?:\/\/api\.weibo\.cn\/2\/(statuses\/(unread_)?(hot_|friends_|container_)?timeline|groups\/timeline) 'del(.ad, .advertises, .trends) | if .statuses then .statuses |= map(select((((.promotion.type == "ad") or (.mblogtypename? | IN("广告", "廣告", "热推", "熱推", "推荐", "推薦")) or (.is_ad == true) or (.is_ad == 1) or (.card_type == 19) or (.content_auth_info.content_auth_title? | IN("广告", "廣告", "热推", "熱推")) or any(.tag_struct[]?.tag_name?; . == "广告" or . == "热推")) | not)) end | if .cards then .cards |= map(select((((.card_type == 19) or (.mblog.promotion.type == "ad") or (.mblog.mblogtypename? | IN("广告", "廣告", "热推", "熱推"))) | not)) end'

# 2. 开屏广告兜底空化与超长冷却周期（防止本地缓存旧广告）
http-response-jq ^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?.*a=get_coopen_ads '.data |= . + {"ad_list":[],"pic_ad":[],"gdt_video_ad_ios":[],"display_ad":0,"ad_ios_id":null,"app_ad_ios_id":null,"reserve_ad_ios_id":"","reserve_app_ad_ios_id":"","ad_duration":604800,"ad_cd_interval":604800}'

# 3. 趋势/发现页布局优化
http-response-jq ^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?.*a=trends 'if .data.order then .data.order = ["search_topic"] end'

# 4. 搜索话题仅剔除顶部置顶推广
http-response-jq ^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?.*a=search_topic 'if .data.search_topic.cards[0].type == "searchtop" then del(.data.search_topic.cards[0]) end'

# 5. 个人中心去除 VIP 营销卡片
http-response-jq ^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?.*a=user_center 'if .data.cards then .data.cards[].items |= map(select(.type != "personal_vip")) | .data.cards |= map(select((.items | length) > 0)) end'

[MITM]
hostname = %APPEND% api.weibo.cn, weibointl.api.weibo.cn
