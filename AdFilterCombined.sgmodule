#!name = 个人广告过滤（微博、YouTube、通用）
#!desc = 合并微博、YouTube 本机去广告和 iFansClub 通用广告拦截。
#!author = hyq58, iab0x00, kokoryh, Antigravity, Maasea, isinglever, akiralereal
#!url = https://raw.githubusercontent.com/hyq58/WeiboIntl/main/AdFilterCombined.sgmodule
#!update = 2026-11-16

# 个人版合并配置。各组成部分的源文件、修改说明及许可见本仓库 NOTICE.md。
# https://github.com/hyq58/WeiboIntl/blob/main/NOTICE.md
# iFansClub ADBlock 及 YouTube 补充规则来自以下 GPL-3.0 源码。
# https://github.com/akiralereal/shadowrocket-toolkit/tree/c5559d9add4aa3e67f841e0380c10b7cd9644a64
# https://raw.githubusercontent.com/akiralereal/shadowrocket-toolkit/c5559d9add4aa3e67f841e0380c10b7cd9644a64/LICENSE
# YouTube 保留个人版的单一播放响应处理，另外拦截独立的广告页和广告统计请求。

[Rule]
# 微博轻享版 / 国际版
# 0. 禁用微博接口 QUIC：QUIC 无法被本机 MITM 解密，App 走 QUIC 时时间线去广告会间歇失效；拒绝后回落 TCP
AND,((DOMAIN,api.weibo.cn),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,weibointl.api.weibo.cn),(PROTOCOL,UDP)),REJECT
# 1. 微博官方第一方开屏与商业广告（实锤捕获 bootpreload, bootrealtime, adimg, adstrategy, vs.biz）
DOMAIN-SUFFIX,uve.weibo.com,REJECT
DOMAIN-SUFFIX,biz.weibo.com,REJECT
DOMAIN-SUFFIX,umeng.com,REJECT
DOMAIN-SUFFIX,umengcloud.com,REJECT

# 2. 封杀轻享版调用的第三方聚合广告兜底联盟（抓包捕获之广点通/快手/申石/趣头条/爱点击/触控等竞价SDK）
DOMAIN-SUFFIX,gdt.qq.com,REJECT
DOMAIN-SUFFIX,ugdtimg.com,REJECT
DOMAIN-SUFFIX,tfogc.com,REJECT
DOMAIN-SUFFIX,aiclk.com,REJECT
DOMAIN-SUFFIX,shenshiads.com,REJECT
DOMAIN-SUFFIX,qttunion.com,REJECT
DOMAIN-SUFFIX,1sapp.com,REJECT
DOMAIN,open.e.kuaishou.com,REJECT
DOMAIN,api.touch-moblie.com,REJECT
DOMAIN,s.adxvip.com,REJECT
DOMAIN-SUFFIX,guanggao-prod.cn-shanghai.log.aliyuncs.com,REJECT

# 3. 2026-10-16 DNS 日志补充：与微博请求时间相邻的广告候选，采用精确域名阻断。
# DNS 正常解析不等于广告已展示；手机效果仍需更新模块后验收。
DOMAIN,df.tanx.com,REJECT
DOMAIN,ef-dongfeng.tanx.com,REJECT
DOMAIN,rdstat.tanx.com,REJECT
DOMAIN,sdk.e.qq.com,REJECT
DOMAIN,sdkquic.e.qq.com,REJECT
DOMAIN,p66-ad.adkwai.com,REJECT

# 4. 2026-10-21 抓包补充：字节跳动穿山甲 SDK 配置与打点
DOMAIN,is.snssdk.com,REJECT
DOMAIN,log.zijieapi.com,REJECT
DOMAIN,mon.zijieapi.com,REJECT

# YouTube
# 禁用 YouTube QUIC：QUIC 无法被本机 MITM 解密，播放流走 QUIC 时 initplayback 去广告失效；拒绝后回落 TCP
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

