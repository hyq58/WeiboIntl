#!name = 个人广告过滤（微博＋YouTube 本机处理版）
#!desc = 微博沿用原规则；YouTube 在小火箭本机处理，无作者 Worker 依赖。
#!author = iab0x00, kokoryh, Antigravity, Maasea, isinglever；整合维护 hyq58
#!url = https://raw.githubusercontent.com/hyq58/WeiboIntl/main/AdFilterLocal.sgmodule

# 自动生成：修改 WeiboIntl.sgmodule 或 local-settings.json 后运行 npm run build。
# 修改说明：合并两个独立模块，去重 MITM 主机名，保留各自来源与许可边界。

[Rule]
# 微博轻享版 / 国际版
# 0. 禁用微博接口 QUIC：QUIC 无法被本机 MITM 解密，App 走 QUIC 时时间线去广告会间歇失效；拒绝后回落 TCP
AND,((DOMAIN,api.weibo.cn),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,weibointl.api.weibo.cn),(PROTOCOL,UDP)),REJECT
# 1. 微博官方第一方开屏与商业广告（实锤捕获 bootpreload, bootrealtime, adimg, adstrategy, vs.biz）
DOMAIN-SUFFIX,uve.weibo.com,REJECT
DOMAIN-SUFFIX,biz.weibo.com,REJECT
DOMAIN-SUFFIX,umeng.com,REJECT

# 2. 封杀轻享版调用的第三方聚合广告兜底联盟（抓包捕获之广点通/快手/申石/趣头条/爱点击/触控等竞价SDK）
DOMAIN-SUFFIX,gdt.qq.com,REJECT
DOMAIN-SUFFIX,ugdtimg.com,REJECT
DOMAIN-SUFFIX,tfogc.com,REJECT
DOMAIN-SUFFIX,aiclk.com,REJECT
DOMAIN-SUFFIX,shenshiads.com,REJECT
DOMAIN-SUFFIX,qttunion.com,REJECT
DOMAIN-SUFFIX,1sapp.com,REJECT
DOMAIN,open.e.kuaishou.com,REJECT
DOMAIN,api.touch-moblie.com,REJECT
DOMAIN,s.adxvip.com,REJECT
DOMAIN-SUFFIX,guanggao-prod.cn-shanghai.log.aliyuncs.com,REJECT

# YouTube
# 禁用 YouTube QUIC：QUIC 无法被本机 MITM 解密，播放流走 QUIC 时 initplayback 去广告失效；拒绝后回落 TCP
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[URL Rewrite]
# 微博轻享版 / 国际版
# 1. 搜索框默认词/推广推荐词
^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?.*a=get_searching_info - reject-dict

# 2. 国际版通用广告配置接口（阻断 pos=3/8/13/18 拼多多/牙黄等本地注入广告源）
^https?:\/\/api\.weibo\.cn\/2\/ad\/ - reject-dict

[Body Rewrite]
# 微博轻享版 / 国际版
# 1. 时间线去广告（全面覆盖热门流、关注流 friends/ 与 friends_、分组流、话题流）
http-response-jq ^https?:\/\/api\.weibo\.cn\/2\/(statuses\/(unread_)?(hot_|friends[\/_]|container_)?timeline|groups\/timeline) 'del(.ad, .advertises, .trends) | if .statuses then .statuses |= map(select((((.promotion.type == "ad") or (.mblogtypename? | IN("广告", "廣告", "热推", "熱推", "推荐", "推薦")) or (.is_ad == true) or (.is_ad == 1) or (.card_type == 19) or (.content_auth_info.content_auth_title? | IN("广告", "廣告", "热推", "熱推")) or any(.tag_struct[]?.tag_name?; . == "广告" or . == "热推")) | not))) end | if .cards then .cards |= map(select((((.card_type == 19) or (.mblog.promotion.type == "ad") or (.mblog.mblogtypename? | IN("广告", "廣告", "热推", "熱推"))) | not))) end'

# 2. 开屏广告兜底空化与插入槽位清空（全面清空 normal/search/video/hot/comment 各场景插入位置，并关闭 CYT/广点通）
http-response-jq ^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?.*a=get_coopen_ads '.data |= . + {"ad_list":[],"pic_ad":[],"gdt_video_ad_ios":[],"display_ad":0,"ad_ios_id":null,"app_ad_ios_id":null,"reserve_ad_ios_id":"","reserve_app_ad_ios_id":"","ad_duration":604800,"ad_cd_interval":604800,"ad_type":"","spare_ad_type":"","close_cyt":1,"uve_ad_scene_insert_normal":"","uve_ad_scene_insert_search":"","uve_ad_scene_insert_video":"","uve_ad_scene_insert_hot":"","uve_ad_scene_insert_comment":""}'

# 3. App 启动全局配置置零（关停 timeline/hot/search/uve 广告总开关）
http-response-jq ^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?.*a=open_app 'if .data then .data += {"new_ad_status_timeline":0,"new_ad_status_hot":0,"new_ad_status_search":0,"uve_feed_ad":0,"uve_feed_ad_block":1,"uve_hot_ad":0,"ad_cyt_regist_enable":0} end'

# 4. 趋势/发现页布局优化
http-response-jq ^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?.*a=trends 'if .data.order then .data.order = ["search_topic"] end'

# 5. 搜索话题仅剔除顶部置顶推广
http-response-jq ^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?.*a=search_topic 'if .data.search_topic.cards[0].type == "searchtop" then del(.data.search_topic.cards[0]) end'

# 6. 个人中心去除 VIP 营销卡片
http-response-jq ^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?.*a=user_center 'if .data.cards then .data.cards[].items |= map(select(.type != "personal_vip")) | .data.cards |= map(select((.items | length) > 0)) end'

[Script]
# YouTube
youtube.local.ad-break = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\/ad_break(?:\?.*)?$,script-path=https://raw.githubusercontent.com/hyq58/WeiboIntl/main/scripts/youtube.local.request.js,argument="{"backgroundPlayback":true,"blockAds":true,"blockUpload":false,"blockShorts":false,"blockImmersive":false,"captionLang":"off","debug":false}"
youtube.local.init = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/hyq58/WeiboIntl/main/scripts/youtube.local.request.js,argument="{"backgroundPlayback":true,"blockAds":true,"blockUpload":false,"blockShorts":false,"blockImmersive":false,"captionLang":"off","debug":false}"
youtube.local.log = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/hyq58/WeiboIntl/main/scripts/youtube.local.request.js,argument="{"backgroundPlayback":true,"blockAds":true,"blockUpload":false,"blockShorts":false,"blockImmersive":false,"captionLang":"off","debug":false}"
youtube.local.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|get_watch|log_event|config)(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/hyq58/WeiboIntl/main/scripts/youtube.local.response.js,argument="{"backgroundPlayback":true,"blockAds":true,"blockUpload":false,"blockShorts":false,"blockImmersive":false,"captionLang":"off","debug":false}"
youtube.local.ump = type=http-response,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/hyq58/WeiboIntl/main/scripts/youtube.local.response.js,argument="{"backgroundPlayback":true,"blockAds":true,"blockUpload":false,"blockShorts":false,"blockImmersive":false,"captionLang":"off","debug":false}"

[MITM]
hostname = %APPEND% api.weibo.cn, weibointl.api.weibo.cn, *.googlevideo.com, youtubei.googleapis.com
